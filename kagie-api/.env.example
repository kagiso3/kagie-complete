PORT=4000
NODE_ENV=production
WEB_APP_URL=https://kagie.co.za
KAGIE_ALLOWED_ORIGINS=https://www.kagie.co.za,https://kagie.app,https://www.kagie.app
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kagie
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Server-side Yoco checkout. Keep disabled until migrations, keys and webhook are verified.
KAGIE_YOCO_ENABLED=false
YOCO_MODE=test
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
# Optional; leave unset to use the official endpoint. Never point to api.yoco.com.
YOCO_API_BASE_URL=https://payments.yoco.com
