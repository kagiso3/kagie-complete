{
  "name": "kagie-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "postinstall": "node scripts/fix-foojay-plugin.js",
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "verify:android-release": "node scripts/verify-release-config.js",
    "build:android": "eas build --platform android --profile production",
    "build:android:local-aab": "cd android && .\\gradlew.bat :app:bundleRelease",
    "build:android:play-aab": "node scripts/verify-release-config.js && cd android && .\\gradlew.bat :app:bundleRelease",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@kagie/shared": "file:../packages/shared",
    "expo": "~55.0.12",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.15",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.14",
    "react": "19.2.0",
    "react-native": "0.83.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-secure-store"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
