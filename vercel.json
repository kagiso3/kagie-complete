{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "web-release",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1/admin/users",
      "destination": "/api/admin/users"
    },
    {
      "source": "/v1/admin/assistants",
      "destination": "/api/admin/assistants"
    },
    {
      "source": "/v1/admin/config/status",
      "destination": "/api/admin/config/status"
    },
    {
      "source": "/v1/admin/marketing/broadcast",
      "destination": "/api/admin/marketing/broadcast"
    },
    {
      "source": "/v1/auth/admin/master-admin/bootstrap",
      "destination": "/api/admin/config/status?__kagie_admin_action=bootstrap"
    },
    {
      "source": "/api/auth/admin/master-admin/bootstrap",
      "destination": "/api/admin/config/status?__kagie_admin_action=bootstrap"
    },
    {
      "source": "/v1/auth/role",
      "destination": "/api/auth/role"
    },
    {
      "source": "/v1/payments/yoco/checkout",
      "destination": "/api/payments/yoco/checkout"
    },
    {
      "source": "/v1/payments/yoco/webhook",
      "destination": "/api/payments/yoco/webhook"
    },
    {
      "source": "/v1/payments/yoco/status",
      "destination": "/api/payments/yoco/status"
    },
    {
      "source": "/v1/payments/payfast/checkout",
      "destination": "/api/payments/payfast/checkout"
    },
    {
      "source": "/v1/payments/payfast/itn",
      "destination": "/api/payments/payfast/itn"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/kagie?path=/v1/:path*"
    },
    {
      "source": "/admin/users",
      "destination": "/admin/users/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "/login.html",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/signup.html",
      "permanent": true
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password.html",
      "permanent": true
    },
    {
      "source": "/change-password",
      "destination": "/changepassword.html",
      "permanent": true
    },
    {
      "source": "/reset-password",
      "destination": "/changepassword.html",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/home.html",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/home.html",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/notification",
      "destination": "/notifications.html",
      "permanent": true
    },
    {
      "source": "/documents",
      "destination": "/documents.html",
      "permanent": true
    },
    {
      "source": "/forms",
      "destination": "/forms.html",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "/android-app.html",
      "permanent": true
    },
    {
      "source": "/android-app",
      "destination": "/android-app.html",
      "permanent": true
    },
    {
      "source": "/android",
      "destination": "/android-app.html",
      "permanent": true
    }
  ]
}
